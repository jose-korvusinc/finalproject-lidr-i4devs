@startuml c2_containers
' =====================================================================
' C4 Model - Level 2: Containers
' Deployable units of the platform and their communication.
' PRD stack: Angular 22, NestJS 11, MongoDB 8.3, Redis, Nginx.
' =====================================================================
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container diagram - Booking & Appointments SaaS Platform

Person(superAdmin, "Super-Admin", "SaaS owner.")
Person(tenantAdmin, "Tenant Admin / Business Owner", "Business owner.")
Person(employee, "Employee / Staff", "Staff who handle appointments.")
Person(customer, "End Customer", "End customer who books without registration.")

System_Ext(googleCalendar, "Google Calendar", "Employee's external calendar.")
System_Ext(emailProvider, "Email Provider", "Email sending service.")

System_Boundary(platform, "Booking & Appointments SaaS Platform") {
    Container(reverseProxy, "Reverse Proxy", "Nginx", "Wildcard routing (*.jpasoftware.com), resolves the tenant subdomain, serves the SPA and proxies the API.")
    Container(webApp, "Web Application", "Angular 22, FullCalendar.io", "SPA providing the backoffice (admin/employee panel, drag&drop calendar) and the public booking widget.")
    Container(api, "API Application", "NestJS 11 (TypeScript), OpenAPI", "Business logic: bookings, availability, OTP, notifications and multitenant context resolution.")
    ContainerDb(mongo, "Operational Database", "MongoDB 8.3", "Shared Database/Collection with indexed tenant_id: businesses, services, employees, working hours, appointments.")
    ContainerDb(redis, "Cache & Temporal Store", "Redis", "OTP codes with TTL and temporary slot locking.")
}

Rel(customer, reverseProxy, "Accesses the public widget of their business", "HTTPS")
Rel(tenantAdmin, reverseProxy, "Manages their business and schedule", "HTTPS")
Rel(employee, reverseProxy, "Checks their daily schedule", "HTTPS")
Rel(superAdmin, reverseProxy, "Manages tenants and plans", "HTTPS")

Rel(reverseProxy, webApp, "Serves the SPA static assets", "HTTPS")
Rel(reverseProxy, api, "Proxies API calls (injects the subdomain/tenant)", "HTTPS / REST")
Rel(webApp, api, "Consumes the API (appointments, availability, OTP)", "JSON / HTTPS")

Rel(api, mongo, "Reads and persists data filtered by tenant_id", "MongoDB Wire Protocol")
Rel(api, redis, "Stores OTP and slot locks with TTL", "RESP")
Rel(api, googleCalendar, "Injects confirmed appointment events (async)", "HTTPS / Google Calendar API")
Rel(api, emailProvider, "Sends OTP and reminders", "SMTP / API")

SHOW_LEGEND()
@enduml
