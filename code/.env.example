# MongoDB container (used by docker-compose.yml)
MONGO_PORT=27017

# Admin (root) user: only bootstraps and administers the container, NOT used by the app
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me_admin

# Application database and least-privilege user (used by the API and migrations)
MONGO_INITDB_DATABASE=bookings
MONGO_APP_USERNAME=bookings_app
MONGO_APP_PASSWORD=change_me_app

# Host path for the data volume
MONGO_DATA_PATH=./mongo-data
