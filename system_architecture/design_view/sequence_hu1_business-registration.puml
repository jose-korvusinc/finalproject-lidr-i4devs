@startuml sequence_hu1_business-registration
' =====================================================================
' Sequence Diagram (RUP Logical/Process View) - HU1
' Scenario: Business registration (main flow + subdomain-taken alt).
' Refines state-diagram_hu1.puml. Stack: Angular -> NestJS -> MongoDB.
' =====================================================================
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam backgroundColor White
skinparam ArrowColor #333333

title Sequence — HU1: Business Registration (main flow + subdomain conflict)

actor "Business Administrator" as admin
boundary "TenantRegistrationComponent\n(Angular)" as ui
control "BusinessController\n(NestJS)" as ctrl
control "BusinessService" as svc
entity "BusinessRepository\n(Mongoose)" as repo
database "MongoDB" as db

admin -> ui : fill(name, email, subdomain)
activate ui
ui -> ctrl : POST /businesses\nRegisterBusinessDto
activate ctrl
ctrl -> svc : register(dto)
activate svc

svc -> repo : findBySubdomain(subdomain)
activate repo
repo -> db : findOne({ subdomain })
db --> repo : result
repo --> svc : Business | null
deactivate repo

alt subdomain available
  svc -> repo : create(Business{ tenantId }, BusinessOwner)
  activate repo
  repo -> db : insert (tenantId, subdomain unique)
  db --> repo : ok
  repo --> svc : Business
  deactivate repo
  svc --> ctrl : BusinessDto
  ctrl --> ui : 201 Created\n{ accessUrl: my-business.jpasoftware.com }
  ui --> admin : show success + access URL
else subdomain taken
  svc --> ctrl : throw ConflictException
  ctrl --> ui : 409 Conflict\n{ error: subdomain in use }
  ui --> admin : show subdomain conflict\n(no partial record created)
end

deactivate svc
deactivate ctrl
deactivate ui

note over repo, db
  Multitenant isolation: the new tenantId scopes
  every subsequent query for this business.
end note
@enduml
