# MongoDB connection (used by the API and by migrate-mongo)
# Uses the least-privilege application user; must match MONGO_APP_* in code/.env
# authSource is the application database (that is where the app user is created), not admin
MONGODB_URI=mongodb://bookings_app:change_me_app@localhost:27017/bookings?authSource=bookings
MONGODB_DB=bookings

# API
PORT=3000
NODE_ENV=development

# Public base domain for tenant portals (portalUrl = https://<subdomain>.<TENANT_BASE_DOMAIN>)
TENANT_BASE_DOMAIN=jpasoftware.com
