@startuml
title Context Model — Selected User Stories (2.3: HU1–HU4)

state "TENANT_REGISTRATION\n(HU1)" as registration
state "SCHEDULE_CONFIGURATION\n(HU2)" as schedule
state "CATALOG_MANAGEMENT\n(HU3)" as catalog
state "PUBLIC_BOOKING\n(HU4)" as booking

note right of registration
  **HU1 — Register business**
  - Register business
  - Validate unique subdomain
  - Create isolated space (tenant)
end note

note right of schedule
  **HU2 — Configure schedule**
  - Define working days
  - Configure opening/closing hours
  - Save availability rules
end note

note right of catalog
  **HU3 — Manage catalog**
  - Create service
  - Create employee
  - Assign service to employee
end note

note right of booking
  **HU4 — Book public appointment**
  - Select service
  - Choose employee and slot
  - Check availability
  - Lock pending slot
end note

[*] --> registration : startSystem

registration --> schedule : configureSchedule
registration --> catalog : manageCatalog
registration --> booking : openBookingWidget
registration --> [*] : closeSystem

schedule --> catalog : manageCatalog
schedule --> booking : openBookingWidget
schedule --> registration : registerBusiness
schedule --> [*] : closeSystem

catalog --> schedule : configureSchedule
catalog --> booking : openBookingWidget
catalog --> registration : registerBusiness
catalog --> [*] : closeSystem

booking --> schedule : configureSchedule
booking --> catalog : manageCatalog
booking --> registration : registerBusiness
booking --> [*] : closeSystem
@enduml
